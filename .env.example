# Digital Calendar Phase 1 - Environment Configuration

# Database Configuration
DATABASE_URL=postgresql://digitalcalendar:digitalcalendar@db:5432/digitalcalendar
POSTGRES_USER=digitalcalendar
POSTGRES_PASSWORD=digitalcalendar
POSTGRES_DB=digitalcalendar

# Backend Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost,http://100.104.202.19:3000
PORT=8000
ENV=production

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000

# Google Calendar Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALENDAR_ID=your_shared_calendar_id@group.calendar.google.com
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# For production, use your Tailscale IP
# GOOGLE_REDIRECT_URI=http://100.104.202.19:8000/auth/google/callback

# Timezone
TZ=America/Los_Angeles
